# AI provider: openai | gemini (optional; default gemini in development, openai otherwise)
# AI_PROVIDER=openai

# OpenAI (ChatGPT) — used when AI_PROVIDER=openai or in production builds
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Google AI Studio (Gemini) — used when AI_PROVIDER=gemini or in development
# GOOGLE_AI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
# GOOGLE_AI_MODEL=gemini-3.5-flash-lite

NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_PROJECT_WALLET=your_project_wallet_address
NEXT_PUBLIC_PRO_PRICE_SOL=0.05
NEXT_PUBLIC_EXTRA_PRICE_SOL=0.2

# Optional custom RPC (recommended for production)
# NEXT_PUBLIC_SOLANA_RPC_URL=
